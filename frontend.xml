import { useEffect, useRef } from "react";
import { Terminal as XTerm } from "@xterm/xterm";
import { FitAddon } from "@xterm/addon-fit";
// 1. Import Clipboard Addon
import "@xterm/xterm/css/xterm.css";
import { ClipboardAddon } from '@xterm/addon-clipboard';
import { getWebContainer } from "../hooks/use-webcontainer";
import { useLocalFiles } from "@/features/test/hooks/use-local-files"; 
import { transformToWebContainerFiles } from "../lib/webcontainer-utils";

export const Terminal = ({ testId }: { testId: string }) => {
  const terminalRef = useRef<HTMLDivElement>(null);
  const xtermRef = useRef<XTerm | null>(null);
  const { files, isLoaded } = useLocalFiles(testId);
  const isMountedRef = useRef(false);

  useEffect(() => {
    if (!terminalRef.current || xtermRef.current) return;

    const fitAddon = new FitAddon();
    // 2. Khởi tạo Clipboard Addon
    const clipboardAddon = new ClipboardAddon();

    const term = new XTerm({
      cursorBlink: true,
      theme: { background: "#1e1e2e", foreground: "#cdd6f4" },
      fontFamily: '"Fira Code", monospace',
      fontSize: 13,
      // 3. Cấu hình để hỗ trợ phím tắt Paste mặc định của trình duyệt
      allowProposedApi: true, 
    });
    
    term.loadAddon(fitAddon);
    // 4. Load Clipboard Addon vào terminal
    term.loadAddon(clipboardAddon);
    
    term.open(terminalRef.current);
    fitAddon.fit();
    xtermRef.current = term;

    const resizeObserver = new ResizeObserver(() => {
      try { fitAddon.fit(); } catch (e) {}
    });
    resizeObserver.observe(terminalRef.current);

    const initTerminal = async () => {
      term.writeln("\x1b[1;36mKhởi động môi trường WebContainer...\x1b[0m");
      try {
        const wc = await getWebContainer();
        
        if (isLoaded && !isMountedRef.current) {
          const containerFiles = transformToWebContainerFiles(files);
          await wc.mount(containerFiles);
          isMountedRef.current = true;
          term.writeln("\x1b[1;32m✅ Đã đồng bộ mã nguồn.\x1b[0m\r\n");
        }

        const shellProcess = await wc.spawn("jsh");
        shellProcess.output.pipeTo(new WritableStream({
          write(data) { term.write(data); }
        }));

        const input = shellProcess.input.getWriter();
        
        // Luồng nhập liệu (bao gồm cả Paste)
        term.onData((data) => {
          input.write(data);
        });

        // 5. Xử lý Paste thủ công qua sự kiện browser để đảm bảo 100% hoạt động
        terminalRef.current?.addEventListener('paste', (e) => {
          const text = e.clipboardData?.getData('text');
          if (text) {
            input.write(text);
          }
        });

      } catch (err) {
        term.writeln("\r\n\x1b[31mLỗi khởi động.\x1b[0m");
      }
    };

    initTerminal();

    return () => {
      resizeObserver.disconnect();
      term.dispose();
      xtermRef.current = null;
    };
  }, [testId, isLoaded]);

  useEffect(() => {
    const syncFiles = async () => {
      if (!isMountedRef.current) return;
      const wc = await getWebContainer();
      for (const node of files) {
        if (node.type === "file") {
          await wc.fs.writeFile(node.name, node.content || "");
        }
      }
    };
    syncFiles();
  }, [files]);

  return (
    <div className="h-full w-full bg-[#1e1e2e] p-2 overflow-hidden flex flex-col">
      <div ref={terminalRef} className="flex-1 w-full min-h-0 overflow-hidden" />
    </div>
  );
};
</file>

<file path="features/editor/components/top-navigation.tsx">
import { ScrollArea, ScrollBar } from "@/components/ui/scroll-area";
import { useEditor } from "../hooks/use-editor";
import { cn } from "@/lib/utils";
import { FileIcon } from "@react-symbols/icons/utils";
import { XIcon } from "lucide-react";
import { useLocalFiles } from "@/features/test/hooks/use-local-files";

const Tab = ({
  fileId,
  isFirst,
  testId, // Đổi từ projectId thành testId
}: {
  fileId: string;
  isFirst: boolean;
  testId: string;
}) => {
  const { files } = useLocalFiles(testId);
  const { activeTabId, previewTabId, setActiveTab, openFile, closeTab } =
    useEditor(testId);

  // Tìm thông tin file trong mảng local thay vì gọi hook Convex
  const file = files.find((f) => f.id === fileId);

  const isActive = activeTabId === fileId;
  const isPreview = previewTabId === fileId;
  const fileName = file?.name ?? "Unknown";

  if (!file) return null; // Nếu không tìm thấy file thì không render tab

  return (
    <div
      onClick={() => setActiveTab(fileId)}
      onDoubleClick={() => openFile(fileId, { pinned: true })}
      className={cn(
        "flex items-center gap-2 h-8.75 pl-2 pr-1.5 cursor-pointer text-muted-foreground group border-y border-x border-transparent hover:bg-accent/30",
        isActive &&
          "bg-background text-foreground border-x-border border-b-background -mb-px drop-shadow",
        isFirst && "border-l-transparent!",
      )}
    >
      <FileIcon fileName={fileName} autoAssign className="size-4" />
      <span className={cn("text-sm whitespace-nowrap", isPreview && "italic")}>
        {fileName}
      </span>
      <button
        onClick={(e) => {
          e.preventDefault();
          e.stopPropagation();
          closeTab(fileId);
        }}
        className={cn(
          "p-0.5 rounded-sm hover:bg-white/10 opacity-0 group-hover:opacity-100",
          isActive && "opacity-100",
        )}
      >
        <XIcon className="size-3.5" />
      </button>
    </div>
  );
};

export const TopNavigation = ({ testId }: { testId: string }) => {
  const { openTabs } = useEditor(testId);

  return (
    <ScrollArea className="flex-1">
      <nav className="bg-sidebar flex items-center h-8.75 border-b">
        {openTabs.map((fileId, index) => (
          <Tab
            key={fileId}
            fileId={fileId}
            isFirst={index === 0}
            testId={testId}
          />
        ))}
      </nav>
      <ScrollBar orientation="horizontal" />
    </ScrollArea>
  );
};
